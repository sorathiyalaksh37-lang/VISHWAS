# VISHWAS Backend Configuration

# Application
APP_NAME=vishwas-api
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./vishwas.db

# Storage
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=50

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=wav,mp3,m4a

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# Analysis
# Set to "real" to use actual ASR and voice models (requires dependencies)
# Set to "mock" for testing without model installation
ANALYSIS_MODE=real
MOCK_PROCESSING_DELAY_SECONDS=2

# ASR Configuration (faster-whisper)
WHISPER_MODEL_SIZE=base           # Options: base, small, medium
WHISPER_DEVICE=cpu                # cpu or cuda (if GPU available)
WHISPER_COMPUTE_TYPE=int8         # int8 (CPU) or float16 (GPU)

# Voice Layer
ENABLE_VOICE_LAYER=true           # Set to false if voice models not installed
VOICE_MIN_DURATION_S=3.0
VOICE_MIN_SNR_DB=5.0

# Tier 2 Agentic AI (Phase 3) - Optional
TIER2_ENABLED=false
TIER2_PROVIDER=openai             # openai, anthropic, or mock
TIER2_MODEL=gpt-4o-mini
TIER2_API_KEY=                    # Add your API key here
TIER2_TIMEOUT=30.0
TIER2_MAX_RETRIES=2

# Logging
LOG_LEVEL=INFO
